{
    "name":  "secure-transfer",
    "version":  "5.4.1.0",
    "description":  "安全传输：豪密 + AES-256-GCM 端到端加密的局域网/公网文字与文件传输",
    "main":  "dist/main/index.js",
    "scripts":  {
                    "build:main":  "tsc -p tsconfig.main.json",
                    "build:preload":  "tsc -p tsconfig.preload.json",
                    "build:renderer":  "vite build --config vite.renderer.config.ts",
                    "build":  "npm run build:main \u0026\u0026 npm run build:preload \u0026\u0026 npm run build:renderer",
                    "dev:renderer":  "vite --config vite.renderer.config.ts",
                    "dev:main":  "wait-on http://localhost:5173 \u0026\u0026 node scripts/electron-dev.js",
                    "dev":  "concurrently -n renderer,main \"npm run dev:renderer\" \"npm run dev:main\"",
                    "start":  "npm run build \u0026\u0026 node scripts/electron-start.js",
                    "pack":  "npm run build \u0026\u0026 electron-builder --dir",
                    "dist":  "npm run build \u0026\u0026 electron-builder",
                    "dist:win":  "npm run build \u0026\u0026 electron-builder --win",
                     "postinstall":  "node scripts/patch-electron-builder.js"
                },
    "build":  {
                  "appId":  "com.securetransfer.app",
                  "productName":  "安全传输",
                  "files":  [
                                "dist/**/*",
                                "resources/**/*"
                            ],
                  "icon":  "resources/icon.png",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             },
                                             {
                                                 "target":  "portable",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "resources/icon.ico",
                              "artifactName":  "安全传输-${version}-${target}.${ext}",
                              "signAndEditExecutable":  true
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "perMachine":  true,
                               "allowToChangeInstallationDirectory":  true,
                               "allowElevation":  true,
                               "deleteAppDataOnUninstall":  true,
                               "include":  "build/installer.nsh",
                               "installerIcon":  "resources/icon.ico",
                               "uninstallerIcon":  "resources/icon.ico",
                               "shortcutName":  "安全传输",
                               "artifactName":  "安全传输-安装程序-v${version}.exe",
                               "installerHeader":  "build/installer-header.bmp"
                           },
                  "portable":  {
                                   "artifactName":  "安全传输-便携版-v${version}.exe"
                               },
                  "executableName":  "SecureTransfer",
                  "afterPack":  "build/afterPack.js",
                  "buildVersion":  "5.4.1.0"
              },
    "keywords":  [
                     "file-sharing",
                     "encrypted",
                     "electron"
                 ],
    "author":  "",
    "license":  "MIT",
    "packageManager":  "traversal",
    "devDependencies":  {
                            "@types/node":  "^25.5.0",
                            "@types/react":  "^19.2.14",
                            "@types/react-dom":  "^19.2.3",
                            "@types/uuid":  "^10.0.0",
                            "@vitejs/plugin-react":  "^6.0.1",
                            "concurrently":  "^9.2.1",
                            "electron":  "^41.0.4",
                            "electron-builder":  "^26.8.1",
                            "typescript":  "^6.0.2",
                            "vite":  "^8.0.3",
                            "wait-on":  "^9.0.4",
                         "bootstrap":  "^5.3.8",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "uuid":  "^13.0.0"
                        }
}












